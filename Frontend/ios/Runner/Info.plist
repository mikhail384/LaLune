<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>LaLune</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>lalune</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.9.18</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>9018</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Background modes: fetch/processing для watchdog, audio — чтобы ядро
	     и локальный SOCKS5 жили в фоне (системный туннель поднимает incy). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>network-authentication</string>
		<string>processing</string>
		<string>audio</string>
	</array>

	<!-- BGTaskScheduler identifier (должен совпадать с AppDelegate). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.lalune.lalune.refresh</string>
	</array>

	<!-- Разрешения на сеть, локальный сервер, ATS -->
	<!-- «Режим звонка» открывает вход аудиосессии, чтобы iOS не усыпляла
	     процесс. Запись не сохраняется и никуда не отправляется. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>LaLune использует микрофон только для того, чтобы iOS не приостанавливала VPN в фоне (режим звонка). Запись не сохраняется и не передаётся.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>LaLune использует локальный API для связи UI с VPN-ядром.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>

	<!-- Файловая система: доступ к Documents / App Group -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Схемы, которые мы проверяем через canOpenURL: incy принимает наш
	     SOCKS5-конфиг, vk — возврат после OAuth. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>incy</string>
		<string>vk</string>
		<string>tg</string>
	</array>

	<!-- URL-схема для OAuth ВК и deep links -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lalune</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
