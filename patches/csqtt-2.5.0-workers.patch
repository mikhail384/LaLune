+fn preliminary_worker_limit(server_limit: Option<u32>, current: u16, requested: u16) -> u16 {
+    if let Some(limit) = server_limit {
+        return limit as u16;
+    }
+    let current = if (3..=MAX_STREAM_WORKERS_U16).contains(&current) { current } else { 0 };
+    match current.max(requested) {
+        0 => MAX_STREAM_WORKERS_U16,
+        count => count,
+    }
+}
+
+fn effective_worker_count(server_limit: Option<u32>, current: u16, requested: u16, worker: u16) -> u16 {
+    if let Some(limit) = server_limit {
+        limit as u16
+    } else if (3..=MAX_STREAM_WORKERS_U16).contains(&current)
+        && (requested == 0 || worker <= current) {
+        current
+    } else if requested > 0 {
+        requested
+    } else {
+        3
+    }
+}
