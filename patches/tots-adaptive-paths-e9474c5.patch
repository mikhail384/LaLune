+    /// Consume a window of authenticated delivery feedback. Idle or lightly used
+    /// paths do not appear slow just because the application sent little traffic.
+    pub fn sample_path_weight(&mut self) -> Option<f64> {
+        let elapsed = self.path_window.since.elapsed().as_secs_f64();
+        if elapsed < 1.0 {
+            return None;
+        }
+        let window = std::mem::replace(&mut self.path_window, PathWindow::new(self.stats));
+        let before = window.baseline;
+        let acked = self.stats.acked_packets.saturating_sub(before.acked_packets);
+        let late = self.stats.late_acked_packets.saturating_sub(before.late_acked_packets);
+        let loss = self.stats.packet_threshold_losses.saturating_sub(before.packet_threshold_losses)
+            .saturating_add(self.stats.time_threshold_losses.saturating_sub(before.time_threshold_losses))
+            .saturating_add(self.stats.pto_expirations.saturating_sub(before.pto_expirations))
+            .saturating_sub(late);
+        let outcomes = acked.saturating_add(late).saturating_add(loss);
+        let reliability = if outcomes >= 8 {
+            let loss_fraction = loss as f64 / outcomes as f64;
+            1.0 - 0.8 * loss_fraction
+        } else {
+            1.0
+        };
+        let throughput = if window.sent_bytes as f64 / elapsed >= ALLOCATION_RATE_BYTES_PER_SEC * 0.5 {
+            let delivered_rate = window.delivered_bytes as f64 / elapsed;
+            (0.5 + delivered_rate / ALLOCATION_RATE_BYTES_PER_SEC).min(1.8)
+        } else {
+            1.0
+        };
+        let latency = self.srtt.map_or(1.0, |rtt| {
+            let delay = rtt.saturating_add(self.rttvar).as_secs_f64();
+            (0.160 / (0.080 + delay)).clamp(0.35, 1.25)
+        });
+        Some((throughput * reliability * latency).clamp(0.2, 2.0))
+    }
